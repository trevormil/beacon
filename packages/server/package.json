{
  "name": "@trevormil/beacon-server",
  "version": "0.1.0",
  "description": "Beacon — Hono+Bun API server with 3-tier auth (public-key + secret + admin).",
  "license": "MIT",
  "author": "Trevor Miller",
  "homepage": "https://github.com/trevormil/beacon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevormil/beacon.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "beacon-server": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trevormil/beacon-shared": "workspace:*",
    "@hono/zod-validator": "0.4.1",
    "hono": "4.6.12",
    "zod": "3.23.8"
  }
}
